# Production Environment Variables Template
# Copy this file and fill in your production values
# DO NOT commit the actual .env.production file with real credentials

# ============================================
# REQUIRED - App Configuration
# ============================================
SECRET_KEY_BASE=generate_with_openssl_rand_hex_64
DEVISE_SECRET_KEY=generate_with_openssl_rand_hex_64
TOKEN_KEY_BASE=generate_with_openssl_rand_hex_64
RAILS_ENV=production
RACK_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# ============================================
# REQUIRED - Database (Auto-set by Heroku)
# ============================================
# DATABASE_URL=postgresql://user:password@host:port/database
# This is automatically set by Heroku when you add postgres addon

# ============================================
# REQUIRED - AWS S3 (File Storage)
# ============================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION_NAME=us-west-1
AWS_REGION=us-west-1
AWS_BUCKET_NAME=your-bucket-name
AWS_BUCKET=your-bucket-name

# ============================================
# REQUIRED - Email (Mailgun)
# ============================================
MAILGUN_HOST=smtp.mailgun.org
MAILGUN_USER=postmaster@your-domain.com
MAILGUN_PASS=your_mailgun_password
MAILGUN_PORT=587
MAILGUN_DOMAIN=your-domain.com

# ============================================
# Branding / UI
# ============================================
COMPANY_LOGO=/assets/beeper_logo.png
LOGIN_BACKGROUND=/assets/beeper-login-background.jpg
COMPANY_BACKGROUND=/assets/beeper-login-background.jpg
SITE_TITLE=Beeper Admin
SITE_ADMIN_NAME=Admin

# ============================================
# OPTIONAL - DNA API Integration
# ============================================
DNA_API_URL=your-api-url
DNA_API_KEY=your-api-key
SITE_URL=your-site-url
SITE_SLUG=your-site-slug

# ============================================
# OPTIONAL - Twilio (SMS Features)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_phone

# ============================================
# OPTIONAL - Pusher (Real-time Features)
# ============================================
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=us3

# ============================================
# OPTIONAL - Auth Token Expiration
# ============================================
TOKEN_EXPIRATION=5184000
