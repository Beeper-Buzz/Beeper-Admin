<%= form_for [:admin, @homepage_section], html: { class: 'form' } do |f| %>
  <fieldset data-hook="<%= submit_label == Spree.t(:create) ? 'new' : 'edit' %>_homepage_section">

    <%= f.field_container :page_key, class: ['form-group'] do %>
      <%= f.label :page_key, 'Page' %> <span class="required">*</span>
      <%= f.select :page_key,
                   options_for_select(HomepageSection::PAGES.map { |p| [p.titleize, p] }, @homepage_section.page_key),
                   {},
                   { class: 'form-control', required: true } %>
      <%= f.error_message_on :page_key %>
      <small class="form-text text-muted">The storefront page this section appears on</small>
    <% end %>

    <%= f.field_container :title, class: ['form-group'] do %>
      <%= f.label :title, 'Title' %> <small class="text-muted">(Optional)</small>
      <%= f.text_field :title, class: 'form-control' %>
      <%= f.error_message_on :title %>
    <% end %>

    <%= f.field_container :section_type, class: ['form-group'] do %>
      <%= f.label :section_type, 'Section Type' %> <span class="required">*</span>
      <%= f.select :section_type,
                   options_for_select(HomepageSection::SECTION_TYPES.map { |t| [t.titleize, t] }, @homepage_section.section_type),
                   { prompt: 'Select section type...' },
                   { class: 'form-control', required: true, id: 'homepage_section_section_type' } %>
      <%= f.error_message_on :section_type %>
      <small class="form-text text-muted">Choose the type of content section</small>
    <% end %>

    <%= f.field_container :content, class: ['form-group'] do %>
      <%= f.label :content, 'Content (HTML/Text)' %>
      <%= f.text_area :content, class: 'form-control', rows: 10, id: 'homepage_section_content' %>
      <%= f.error_message_on :content %>
      <small class="form-text text-muted">Main content for this section</small>
    <% end %>

    <%= f.field_container :settings, class: ['form-group'] do %>
      <%= f.label :settings, 'Settings (JSON)' %>
      <%= f.text_area :settings, value: @homepage_section.settings_json, class: 'form-control text-monospace', rows: 14, placeholder: '{ "key": "value" }' %>
      <%= f.error_message_on :settings %>
      <small class="form-text text-muted">
        Additional configuration in JSON format.
        <span id="settings_help_example"></span>
      </small>
    <% end %>

    <%= f.field_container :position, class: ['form-group'] do %>
      <%= f.label :position, 'Position' %>
      <%= f.number_field :position, class: 'form-control', min: 1 %>
      <%= f.error_message_on :position %>
      <small class="form-text text-muted">Order position on the page (lower numbers appear first)</small>
    <% end %>

    <%= f.field_container :is_visible, class: ['form-group'] do %>
      <div class="form-check">
        <%= f.check_box :is_visible, class: 'form-check-input' %>
        <%= f.label :is_visible, 'Visible on website', class: 'form-check-label' %>
      </div>
      <%= f.error_message_on :is_visible %>
    <% end %>

    <div class="form-actions" data-hook="buttons">
      <%= button submit_label, 'save.svg' %>
      <%= button_link_to Spree.t(:cancel), admin_homepage_sections_path(page_key: @homepage_section.page_key), icon: 'cancel.svg' %>
    </div>

  </fieldset>
<% end %>

<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof CKEDITOR !== 'undefined') {
      CKEDITOR.replace('homepage_section_content', {
        height: 400,
        versionCheck: false,
        toolbar: [
          ['Bold', 'Italic', 'Underline', 'Strike'],
          ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent'],
          ['Link', 'Unlink', 'Anchor'],
          ['Image', 'Table', 'HorizontalRule', 'SpecialChar'],
          ['Format', 'FontSize'],
          ['TextColor', 'BGColor'],
          ['Maximize', '-', 'Source']
        ]
      });
    }

    // Show what the chosen section type reads from settings.
    var help = <%= raw HomepageSection::SETTINGS_HELP.to_json %>;
    var type = document.getElementById('homepage_section_section_type');
    var example = document.getElementById('settings_help_example');
    function showHelp() {
      var json = help[type.value];
      example.textContent = json ? 'Example for this type: ' + json : '';
    }
    type.addEventListener('change', showHelp);
    showHelp();
  });
</script>
